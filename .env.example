# Copy this file to .env and fill in your own values.
# Never commit your real .env file — it's already in .gitignore.

# Your Gmail address
GMAIL_USER=you@gmail.com

# A 16-character Gmail App Password — NOT your normal Google password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for your account).
# See README.md for the full walkthrough.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Local port the app runs on
PORT=3000
